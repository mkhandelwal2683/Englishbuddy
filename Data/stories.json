      },
      {
        "hindi": "उसने बटुआ उसके मालिक को लौटा दिया।",
        "english": "He returned the wallet to its owner."
      },
      {
        "hindi": "मालिक बहुत खुश हुआ।",
        "english": "The owner was very happy."
      },
      {
        "hindi": "ईमानदारी सबसे अच्छी नीति है।",
        "english": "Honesty is the best policy."
      }
